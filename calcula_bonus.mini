idade = 20 + 5 * 2;
bonus = 10;
total = idade + bonus * 2;

if (total > 40) {
  categoria = 1;
} else {
  categoria = 0;
}

for (i = 1; i <= 5; i = i + 1) {
  total = total + i;
}

if (total == 56) {
  resultado = 100;
} else {
  resultado = 200;
}

soma = 0;
n = 1;
while (n <= 10) {
  soma = soma + n;
  n = n + 1;
}

function dobro(value) {
  return value * 2;
}
dobrado = dobro(soma);

function somarTudo(a, b, c) {
  return a + b + c;
}
combinado = somarTudo(dobrado, total, categoria);
somarTudo(1, 2, 3);
